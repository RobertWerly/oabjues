# Variáveis do BFF de jurisprudência.
#
# ⚠️  RENOMEAR ESTE ARQUIVO PARA .env NÃO FUNCIONA.
#
# O BFF lê as variáveis com getenv(), e o PHP não carrega arquivo .env
# sozinho — isso é coisa de framework (Laravel, Symfony), não da linguagem.
# Um .env solto aqui é ignorado pelo código E fica dentro da pasta publicada,
# onde o servidor pode entregá-lo como texto para qualquer visitante. Ou seja:
# não funciona e ainda vaza.
#
# Este arquivo é só o MOLDE dos três nomes. Defina os valores num dos três
# lugares abaixo, conforme o servidor de vocês.
#
# Os valores reais chegam por canal fechado, junto com a chave.

# ── Os três nomes ───────────────────────────────────────────────────────────

# Endereço da API do JurimetriaES
OABJUS_URL="https://SEU-PROJETO.supabase.co/functions/v1/oab-api"

# Identificador da chave entregue à OAB-ES
OABJUS_CHAVE="oabes-prod"

# Segredo correspondente. Assina cada chamada com HMAC-SHA256 e NUNCA trafega:
# nem para o navegador, nem para o JurimetriaES. Se vazar, peça um par novo.
OABJUS_SEGREDO="cole-aqui-o-segredo-recebido"

# ── Onde definir de verdade ─────────────────────────────────────────────────
#
# Apache (VirtualHost ou .htaccess do site):
#
#     SetEnv OABJUS_URL      https://SEU-PROJETO.supabase.co/functions/v1/oab-api
#     SetEnv OABJUS_CHAVE    oabes-prod
#     SetEnv OABJUS_SEGREDO  o-segredo-recebido
#
# PHP-FPM (o arquivo do pool, normalmente /etc/php/8.x/fpm/pool.d/www.conf):
#
#     env[OABJUS_URL]     = https://SEU-PROJETO.supabase.co/functions/v1/oab-api
#     env[OABJUS_CHAVE]   = oabes-prod
#     env[OABJUS_SEGREDO] = o-segredo-recebido
#
#     Atenção: por padrão o PHP-FPM tem `clear_env = yes`, que apaga o ambiente
#     herdado. Defina por `env[...]` como acima, ou ponha `clear_env = no`.
#
# nginx + FastCGI (no bloco location do PHP):
#
#     fastcgi_param OABJUS_URL      "https://SEU-PROJETO.supabase.co/functions/v1/oab-api";
#     fastcgi_param OABJUS_CHAVE    "oabes-prod";
#     fastcgi_param OABJUS_SEGREDO  "o-segredo-recebido";
#
#     Com FastCGI os valores chegam em $_SERVER, e não em getenv(). Se usarem
#     esta forma, troque as três linhas de getenv() no topo de
#     jurisprudencia.php por $_SERVER — ou prefiram uma das duas de cima.
#
# ── Como conferir ───────────────────────────────────────────────────────────
#
#     curl "https://<portal>/bff/jurisprudencia.php?rota=vocabulario&recurso=habeas_corpus"
#
#   JSON com câmaras e assuntos ....... está certo
#   {"erro":"...não configurado"} ..... as variáveis não chegaram ao PHP
#   o código-fonte PHP na tela ........ o .php não está sendo executado
