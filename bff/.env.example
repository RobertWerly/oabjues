# Variáveis do BFF de jurisprudência — copie para a configuração do processo
# PHP (não para um arquivo servido pelo webserver).
#
# Os valores reais chegam por canal fechado, junto com a chave. Este arquivo é
# só o molde: NÃO coloque segredo aqui, ele vai para o Git.

# Endereço da API do JurimetriaES
OABJUS_URL="https://SEU-PROJETO.supabase.co/functions/v1/oab-api"

# Identificador da chave entregue à OAB-ES
OABJUS_CHAVE="oabes-prod"

# Segredo correspondente. Assina cada chamada com HMAC-SHA256 e NUNCA trafega:
# nem para o navegador, nem para o JurimetriaES. Se vazar, peça um par novo.
OABJUS_SEGREDO="cole-aqui-o-segredo-recebido"
