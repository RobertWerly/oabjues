{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/acordao/:id",
      "destination": "/acordao"
    },
    {
      "source": "/bff/jurisprudencia.php",
      "destination": "/api/jurisprudencia"
    }
  ]
}
